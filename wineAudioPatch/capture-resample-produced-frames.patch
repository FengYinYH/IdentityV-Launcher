From: IdentityV on Mac maintainers
Subject: [PATCH] winecoreaudio: copy only frames produced by capture converter

AudioConverterFillComplexBuffer rewrites its packet-count in/out argument to
actual output. The original wanted_frames variable therefore already carries
actual frames after the call; the earlier full-request/stale-tail explanation
was incorrect (confirmed with an offline real AudioConverter on 2026-11-07).
Keep the existing byte-count clamp and zero-output break as defensive checks.
This patch is already in the default-following runtime; the 2026-09-25 audio1
trial did not eliminate the reported voice-playback artifact. It is preserved
here for source reproduction, not presented as a new artifact fix.

diff --git a/dlls/winecoreaudio.drv/coreaudio.c b/dlls/winecoreaudio.drv/coreaudio.c
--- a/dlls/winecoreaudio.drv/coreaudio.c
+++ b/dlls/winecoreaudio.drv/coreaudio.c
@@ -1218,6 +1218,7 @@ static void capture_resample(struct coreaudio_stream *stream)
     while(stream->cap_held_frames > resamp_period_frames * 2){
         AudioBufferList converted_list;
         UInt32 wanted_frames = stream->period_frames;
+        UInt32 produced_frames;
 
         converted_list.mNumberBuffers = 1;
         converted_list.mBuffers[0].mNumberChannels = stream->fmt->nChannels;
@@ -1238,18 +1239,25 @@ static void capture_resample(struct coreaudio_stream *stream)
             break;
         }
 
+        produced_frames = min(wanted_frames,
+                              converted_list.mBuffers[0].mDataByteSize / stream->fmt->nBlockAlign);
+        if(!produced_frames){
+            WARN("AudioConverterFillComplexBuffer produced no capture frames\n");
+            break;
+        }
+
         ca_wrap_buffer(stream->local_buffer,
                        stream->wri_offs_frames * stream->fmt->nBlockAlign,
                        stream->bufsize_frames * stream->fmt->nBlockAlign,
-                       stream->resamp_buffer, wanted_frames * stream->fmt->nBlockAlign);
+                       stream->resamp_buffer, produced_frames * stream->fmt->nBlockAlign);
 
-        stream->wri_offs_frames += wanted_frames;
+        stream->wri_offs_frames += produced_frames;
         stream->wri_offs_frames %= stream->bufsize_frames;
-        if(stream->held_frames + wanted_frames > stream->bufsize_frames){
+        if(stream->held_frames + produced_frames > stream->bufsize_frames){
             stream->lcl_offs_frames += buf_ptr_diff(stream->lcl_offs_frames, stream->wri_offs_frames,
                                                     stream->bufsize_frames);
             stream->held_frames = stream->bufsize_frames;
         }else
-            stream->held_frames += wanted_frames;
+            stream->held_frames += produced_frames;
     }
 }
