+static AudioObjectPropertyAddress default_device_address(EDataFlow flow)
+{
+    AudioObjectPropertyAddress addr =
+    {
+        .mScope = kAudioObjectPropertyScopeGlobal,
+        .mElement = kAudioObjectPropertyElementMain,
+        .mSelector = flow == eRender ? kAudioHardwarePropertyDefaultOutputDevice :
+                                       kAudioHardwarePropertyDefaultInputDevice,
+    };
+    return addr;
+}
+
+/* Read only the current default property. Do not query the global device list. */
+static HRESULT get_default_device(EDataFlow flow, AudioDeviceID *device)
+{
+    AudioObjectPropertyAddress addr = default_device_address(flow);
+    UInt32 size = sizeof(*device);
+    OSStatus sc = AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, device);
+
+    if(sc != noErr || *device == kAudioObjectUnknown){
+        *device = kAudioObjectUnknown;
+        return AUDCLNT_E_DEVICE_INVALIDATED;
+    }
+    return S_OK;
+}
 
+static BOOL stream_is_quitting(struct coreaudio_stream *stream)
+{
+    return __atomic_load_n(&stream->please_quit, __ATOMIC_ACQUIRE);
+}
