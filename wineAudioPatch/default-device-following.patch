+        silence_buffer(stream, stream->local_buffer, stream->bufsize_frames);
+    if(stream->cap_buffer)
+        memset(stream->cap_buffer, 0, stream->cap_bufsize_frames * stream->fmt->nBlockAlign);
+    free(stream->wrap_buffer);
+    stream->wrap_buffer = NULL;
+    stream->wrap_bufsize_frames = 0;
 }
 
+/* Called only by unix_timer_loop, never by the CoreAudio render/capture callback. */
+static HRESULT follow_default_device(struct coreaudio_stream *stream, AudioDeviceID device)
+{
+    AudioComponentInstance old_unit, new_unit = NULL;
+    AudioConverterRef old_converter, new_converter = NULL;
+    AudioStreamBasicDescription new_desc;
+    BYTE *new_cap_buffer = NULL;
+    UINT32 new_cap_frames = 0;
+    HRESULT hr = S_OK;
+    AudioDeviceID confirmed_device = kAudioObjectUnknown;
+
+    os_unfair_lock_lock(&stream->lock);
+    if(stream->reconfiguring){
+        os_unfair_lock_unlock(&stream->lock);
+        return E_PENDING;
+    }
+    if(!idv_audio_route_needs_rebuild(stream->dev_id, device,
+                                     stream->audio_available, stream->reconfiguring)){
+        os_unfair_lock_unlock(&stream->lock);
+        return S_OK;
+    }
+    stream->audio_available = FALSE;
+    if(stream->getbuf_last){
+        os_unfair_lock_unlock(&stream->lock);
+        return E_PENDING;
+    }
+    stream->reconfiguring = TRUE;
+    clear_stream_audio_backlog(stream);
+    old_unit = stream->unit;
+    old_converter = stream->converter;
+    os_unfair_lock_unlock(&stream->lock);
+
+    /* The callback sees audio_available=false and returns quickly. Stop and
+     * dispose outside the stream lock so AudioOutputUnitStop can drain it. */
+    if(old_unit){
+        AudioOutputUnitStop(old_unit);
+        AudioComponentInstanceDispose(old_unit);
+    }
+    if(old_converter) AudioConverterDispose(old_converter);
+
+    if(device == kAudioObjectUnknown)
+        hr = AUDCLNT_E_DEVICE_INVALIDATED;
+    else
+        hr = create_stream_audio_unit(stream, device, &new_unit, &new_desc, &new_converter);
+    if(SUCCEEDED(hr)) hr = start_stream_audio_unit(new_unit);
+    if(SUCCEEDED(hr) && stream->flow == eCapture){
+        new_cap_frames = muldiv(stream->duration, new_desc.mSampleRate, 10000000);
+        if(!idv_audio_capture_buffer_size_valid(new_cap_frames, stream->fmt->nBlockAlign, (SIZE_T)-1))
+            hr = E_OUTOFMEMORY;
+        else if(!(new_cap_buffer = calloc(new_cap_frames, stream->fmt->nBlockAlign)))
+            hr = E_OUTOFMEMORY;
+    }
+    /* A second switch may happen while AudioUnitInitialize/Start is running.
+     * Publish only if the device is still the macOS default now. */
+    {
+        HRESULT route_status = get_default_device(stream->flow, &confirmed_device);
+        if(!idv_audio_route_candidate_matches(device, confirmed_device,
+                                              SUCCEEDED(route_status), SUCCEEDED(hr),
+                                              stream->flow != eCapture || new_cap_buffer != NULL,
+                                              stream_is_quitting(stream)) && SUCCEEDED(hr))
+            hr = AUDCLNT_E_DEVICE_INVALIDATED;
+    }
+
+    if(FAILED(hr)){
+        if(new_unit){ AudioOutputUnitStop(new_unit); AudioComponentInstanceDispose(new_unit); }
+        if(new_converter) AudioConverterDispose(new_converter);
+        free(new_cap_buffer);
+        new_unit = NULL;
+        new_converter = NULL;
+        new_cap_buffer = NULL;
+    }
+
+    os_unfair_lock_lock(&stream->lock);
+    stream->unit = new_unit;
+    stream->converter = new_converter;
+    stream->dev_id = SUCCEEDED(hr) ? device : kAudioObjectUnknown;
+    if(SUCCEEDED(hr)) stream->dev_desc = new_desc;
+    if(stream->flow == eCapture){
+        free(stream->cap_buffer);
+        stream->cap_buffer = new_cap_buffer;
+        stream->cap_bufsize_frames = SUCCEEDED(hr) ? new_cap_frames : 0;
+    }
+    if(SUCCEEDED(hr) && stream->have_volumes){
+        Float32 level = stream->master_volume;
+        AudioObjectPropertyAddress prop_addr = {
+            kAudioDevicePropertyVolumeScalar,
+            kAudioObjectPropertyScopeGlobal,
+            kAudioObjectPropertyElementMain
+        };
+        OSStatus sc = AudioObjectSetPropertyData(stream->dev_id, &prop_addr, 0, NULL, sizeof(level), &level);
+        if(sc == noErr) level = 1.0f;
+        for(UINT32 i = 1; i <= stream->fmt->nChannels; ++i){
+            Float32 volume = level * stream->session_volumes[i - 1] * stream->channel_volumes[i - 1];
+            prop_addr.mElement = i;
+            AudioObjectSetPropertyData(stream->dev_id, &prop_addr, 0, NULL, sizeof(volume), &volume);
+        }
+    }
+    stream->audio_available = SUCCEEDED(hr);
+    stream->reconfiguring = FALSE;
+    os_unfair_lock_unlock(&stream->lock);
+
+    if(FAILED(hr))
+        WARN("Couldn't follow default %s device; retrying: %x\n",
+             stream->flow == eRender ? "output" : "input", (int)hr);
+    return hr;
+}
