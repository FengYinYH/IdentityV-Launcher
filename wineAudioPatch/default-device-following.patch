+static HRESULT create_stream_audio_unit(struct coreaudio_stream *stream, AudioDeviceID device,
+                                        AudioComponentInstance *unit_out,
+                                        AudioStreamBasicDescription *dev_desc_out,
+                                        AudioConverterRef *converter_out)
+{
+    AURenderCallbackStruct input;
+    AudioComponentInstance unit;
+    AudioConverterRef converter = NULL;
+    HRESULT hr;
+    OSStatus sc;
+
+    *unit_out = NULL;
+    *converter_out = NULL;
+    if(!(unit = get_audiounit(stream->flow, device)))
+        return AUDCLNT_E_DEVICE_INVALIDATED;
+
+    hr = ca_setup_audiounit(stream->flow, unit, stream->fmt, dev_desc_out, &converter);
+    if(FAILED(hr)) goto failed;
+
+    input.inputProcRefCon = stream;
+    if(stream->flow == eCapture){
+        input.inputProc = ca_capture_cb;
+        sc = AudioUnitSetProperty(unit, kAudioOutputUnitProperty_SetInputCallback,
+                                  kAudioUnitScope_Output, 1, &input, sizeof(input));
+    }else{
+        input.inputProc = ca_render_cb;
+        sc = AudioUnitSetProperty(unit, kAudioUnitProperty_SetRenderCallback,
+                                  kAudioUnitScope_Input, 0, &input, sizeof(input));
+    }
+    if(sc != noErr){
+        WARN("Couldn't set callback: %x\n", (int)sc);
+        hr = osstatus_to_hresult(sc);
+        goto failed;
+    }
+
+    *unit_out = unit;
+    *converter_out = converter;
+    return S_OK;
+
+failed:
+    if(converter) AudioConverterDispose(converter);
+    AudioComponentInstanceDispose(unit);
+    return hr;
+}
+
+static HRESULT start_stream_audio_unit(AudioComponentInstance unit)
+{
+    OSStatus sc = AudioUnitInitialize(unit);
+    if(sc != noErr){
+        WARN("Couldn't initialize: %x\n", (int)sc);
+        return osstatus_to_hresult(sc);
+    }
+    sc = AudioOutputUnitStart(unit);
+    if(sc != noErr){
+        WARN("Unit failed to start: %x\n", (int)sc);
+        return osstatus_to_hresult(sc);
+    }
+    return S_OK;
+}
