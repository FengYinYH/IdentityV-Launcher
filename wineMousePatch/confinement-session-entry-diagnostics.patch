Subject: [PATCH] winemac: Trace diagnostic presence and first cursor API paths.

Apply after confinement-session-diagnostics.patch. Only an explicitly compiled
diagnostic build emits one env-independent module presence marker. All other
records require the exact session flag; all share one 64-record process budget.

--- /dev/null
+++ b/dlls/winemac.drv/capture_diagnostics.h
@@ -0,0 +1,31 @@
+/* Explicit-session diagnostics only; no input hooks, workers or timers.
+ * A single process-wide budget covers C entry markers and native snapshots. */
+#ifndef IDV_CAPTURE_DIAGNOSTICS_H
+#define IDV_CAPTURE_DIAGNOSTICS_H
+#include <stdio.h>
+#include <stdint.h>
+#define IDV_DIAG_HIDDEN __attribute__((visibility("hidden")))
+enum idv_capture_diag_once {
+    IDV_DIAG_MODULE = 1u << 0,
+    IDV_DIAG_RESET = 1u << 1,
+    IDV_DIAG_NULL = 1u << 2,
+    IDV_DIAG_RECT = 1u << 3,
+    IDV_DIAG_HANDLER = 1u << 4,
+    IDV_DIAG_NO_OWNER = 1u << 5,
+    IDV_DIAG_EMPTY = 1u << 6,
+    IDV_DIAG_START_FAILED = 1u << 7,
+    IDV_DIAG_CAPTURE_SET = 1u << 8,
+    IDV_DIAG_WARP = 1u << 9,
+    IDV_DIAG_EVENT_NO_CLIP = 1u << 10,
+    IDV_DIAG_BOUNDED = 1u << 11,
+    IDV_DIAG_UNBOUNDED = 1u << 12,
+    IDV_DIAG_CAPTURE_CLEAR = 1u << 13,
+    IDV_DIAG_OPTIONS = 1u << 14
+};
+IDV_DIAG_HIDDEN int macdrv_capture_diag_enabled(void);
+IDV_DIAG_HIDDEN int macdrv_capture_diag_has_budget(void);
+IDV_DIAG_HIDDEN int macdrv_capture_diag_begin(unsigned once_bit, int force);
+IDV_DIAG_HIDDEN void macdrv_capture_diag_end(void);
+IDV_DIAG_HIDDEN void macdrv_capture_diag_log(unsigned once_bit, const char *format, ...);
+IDV_DIAG_HIDDEN void macdrv_capture_diag_module_start(int native_config);
+#endif
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -25,6 +25,12 @@
 #endif
 
 #include "config.h"
+#include "capture_diagnostics.h"
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
 
 #include <Security/AuthSession.h>
 #include <IOKit/pwr_mgt/IOPMLib.h>
@@ -36,6 +42,83 @@
 #include "wine/server.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(macdrv);
+
+/* IDV_CAPTURE_TRANSPORT_BEGIN: shared, bounded stderr transport. */
+static pthread_mutex_t capture_diag_mutex = PTHREAD_MUTEX_INITIALIZER;
+static unsigned capture_diag_records, capture_diag_once_bits;
+
+int macdrv_capture_diag_enabled(void)
+{
+    const char *value = getenv("IDENTITYV_CAPTURE_DIAGNOSTICS");
+    return value && !strcmp(value, "1");
+}
+
+int macdrv_capture_diag_has_budget(void)
+{
+    int result;
+    pthread_mutex_lock(&capture_diag_mutex);
+    result = capture_diag_records < 64;
+    pthread_mutex_unlock(&capture_diag_mutex);
+    return result;
+}
+
+int macdrv_capture_diag_begin(unsigned once_bit, int force)
+{
+    if (!force && !macdrv_capture_diag_enabled()) return 0;
+    pthread_mutex_lock(&capture_diag_mutex);
+    if (capture_diag_records >= 64 || (once_bit && (capture_diag_once_bits & once_bit)))
+    {
+        pthread_mutex_unlock(&capture_diag_mutex);
+        return 0;
+    }
+    capture_diag_once_bits |= once_bit;
+    fprintf(stderr, "IDV_CAPTURE_DIAG v=2 pid=%d seq=%u ", getpid(), ++capture_diag_records);
+    return 1;
+}
+
+void macdrv_capture_diag_end(void)
+{
+    fputc('\n', stderr);
+    fflush(stderr);
+    pthread_mutex_unlock(&capture_diag_mutex);
+}
+
+void macdrv_capture_diag_log(unsigned once_bit, const char *format, ...)
+{
+    va_list args;
+    if (!macdrv_capture_diag_begin(once_bit, 0)) return;
+    va_start(args, format);
+    vfprintf(stderr, format, args);
+    va_end(args);
+    macdrv_capture_diag_end();
+}
+
+void macdrv_capture_diag_module_start(int native_config)
+{
+    int diagnostic_build = 0;
+#ifdef IDENTITYV_CAPTURE_DIAGNOSTIC_BUILD
+    diagnostic_build = 1;
+#endif
+    /* Only this marker may bypass the env gate, and only in an explicitly
+     * built isolated diagnostic module. Report one boolean, never environment
+     * contents. Otherwise a lost flag is indistinguishable from no clip calls. */
+    if (macdrv_capture_diag_begin(IDV_DIAG_MODULE, diagnostic_build))
+    {
+        fprintf(stderr, "reason=module-start enabled=%d diagnosticBuild=%d nativeConfig=%d budget=64",
+                macdrv_capture_diag_enabled(), diagnostic_build, native_config);
+        macdrv_capture_diag_end();
+    }
+}
+#ifdef IDENTITYV_CAPTURE_DIAGNOSTIC_BUILD
+__attribute__((constructor)) static void capture_diagnostic_module_loaded(void)
+{
+    /* Presence only: options and Cocoa have not been initialized yet. */
+    macdrv_capture_diag_module_start(-1);
+}
+#endif
+/* IDV_CAPTURE_TRANSPORT_END */
+
+
 
 #define IS_OPTION_TRUE(ch) \
     ((ch) == 'y' || (ch) == 'Y' || (ch) == 't' || (ch) == 'T' || (ch) == '1')
@@ -458,6 +541,8 @@
 
